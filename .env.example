# Outbound email (alerts when a ticket is reserved).
# Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
ALERT_TO=you@gmail.com

# Optional: IMAP IDLE listener for TicketSwap alert emails.
# Faster than polling because it reacts the second TicketSwap fires the alert.
# Leave blank to disable; the app will run in polling-only mode.
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASS=your-app-password

# Where Playwright stores the logged-in browser profile. Must be writable.
TICKETSWAP_PROFILE_DIR=./.chromium-profile

# Where the watches list is stored.
WATCHES_PATH=./watches.json
